# Gabungkan konfigurasi ke .env; pertahankan token CI yang sudah digunakan.
TELEGRAM_BOT_TOKEN_CI=isi-token-ci-yang-sama
PESERTA_CSV=peserta.csv
CI_CHAT_IDS=-1001234567890
CI_FACILITATOR_IDS=
CI_INSTRUCTOR_IDS=
CI_DATABASE=ci.sqlite3
CI_OFFSET_FILE=ci-offset.txt
CI_POLL_TIMEOUT=30
CI_ANALYSIS_SECONDS=600
CI_SUMMARY_SECONDS=1200
CI_RETENTION_DAYS=90

# Versi 2 — ambang indikator proses dan cooldown intervensi lokal
CI_PARTICIPATION_MIN_MESSAGES=6
CI_DOMINANCE_SHARE=0.45
CI_ACTIVE_RATIO=0.60
CI_INTERVENTION_COOLDOWN_SECONDS=1200

# Versi 3 — demo sintetik default; live memerlukan OIDC di secrets.toml
CI_DASHBOARD_MODE=demo
